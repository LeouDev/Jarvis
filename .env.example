# ── AI providers (server-side only; never exposed to the browser) ──
# Primary provider: gemini | groq | openrouter | claude
AI_PROVIDER=gemini
# Comma-separated fallbacks, tried in order when the primary fails (only configured ones are used)
AI_FALLBACK=groq,openrouter
# Switch to the fallback if the primary hasn't started answering within this many ms (free tiers can queue)
# AI_FIRST_CHUNK_TIMEOUT_MS=6000

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Supabase ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Not used by v1 (all access goes through RLS with the user's JWT). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Only these accounts may use the API (comma-separated). Strongly recommended on a public deployment.
JARVIS_ALLOWED_EMAILS=

# ── Local Mac agent ──
JARVIS_LOCAL_AGENT_URL=http://localhost:3847

# ── Optional services ──
# Web search: Tavily free tier (https://tavily.com). Without it JARVIS falls back to Wikipedia search.
TAVILY_API_KEY=
# GitHub read access (fine-grained token, read-only). Without it, public data only (60 req/h).
GITHUB_TOKEN=
GITHUB_USERNAME=
# 32-byte base64 key used to encrypt connected-account tokens (Facebook etc.).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
